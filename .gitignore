# ATTENTION : ce fichier DOIT rester en UTF-8 sans BOM.
# Il a été committé une fois en UTF-16LE (BOM FF FE + octets nuls entre les caractères).
# Git ne lit que de l'UTF-8 : le fichier entier devenait illisible pour lui, plus rien
# n'était ignoré, et 39 109 fichiers de node_modules se sont retrouvés dans le dépôt.
# Conséquence sur Vercel : git ne conserve pas le bit d'exécution sous Windows, donc
# node_modules/.bin/vite arrivait sur Linux sans +x et le build échouait en exit 126
# (« Permission denied »). Vérifier l'encodage avant tout commit de ce fichier.

# Dépendances — jamais dans le dépôt, réinstallées à partir de package-lock.json.
node_modules/

# Sorties de build
dist/
.output/
.wrangler/
.tanstack/

# Lockfile : package-lock.json EST versionné (installs reproductibles sur Vercel).
bun.lock

# Artefacts du serveur Playwright MCP (captures d'écran, journaux de session) — pas du code.
.playwright-mcp/

# Secrets locaux (.env) : jamais versionnés.
.env

# Journaux (dev-server.log, etc.) : jamais versionnés.
*.log

# Cache npm local (installs hors sandbox) et profils Chrome des outils de test.
.npm-cache/
.chrome-test*/

# Captures des tests responsive (tools/responsive-test.mjs).
.responsive-shots/

